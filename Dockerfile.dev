FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# ninja-build, ccache and rsync are what tools/devbuild.sh needs; see that
# script for why the dev build does not compile straight off the bind mount.
RUN apt update && apt install -y \
    gcc \
    build-essential \
    ccache \
    cmake \
    ninja-build \
    pkg-config \
    rsync \
    libxerces-c-dev \
    libmysqlclient-dev \
    liblua5.1-dev \
    zlib1g-dev \
    xutils-dev \
    psmisc

RUN mkdir /home/darkeden
RUN mkdir /home/darkeden/vs
RUN mkdir /home/darkeden/vs/src

WORKDIR /home/darkeden/vs
