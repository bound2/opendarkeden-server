# Keep the build context small - only CMakeLists.txt, src/, third_party/,
# data/ and docker/ are consumed by the Dockerfile.
.git
.github
.claude
.vscode
.idea

# Build output (the image builds its own)
build/
build-tests/
bin/
lib/
*.o
*.a
*.so
# The Rust gateway builds in its own image (docker/docker-compose.yml)
src/server/websocketproxyserver/target/

# Not needed inside the image
initdb/
conf/
Dockerfile.dev
Dockerfile.pub
*.md
docs
