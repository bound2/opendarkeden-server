#!/bin/sh
# Wrapper: `zig cc` is two words, but CMAKE_C_COMPILER must be a single
# executable. Everything after `cc` is a clang-compatible command line.
#
# Zig is located in this order:
#   $ZIG                 - explicit path, wins if set
#   zig on $PATH         - a normal toolchain install
#   python3 -m ziglang   - the PyPI `ziglang` package
#
# ZIG_TARGET, when set, is forwarded as -target (e.g. x86_64-linux-gnu.2.17
# to pin the oldest glibc the binary may depend on).
set -e

if [ -n "${ZIG}" ]; then
    exec "${ZIG}" cc ${ZIG_TARGET:+-target "${ZIG_TARGET}"} "$@"
elif command -v zig >/dev/null 2>&1; then
    exec zig cc ${ZIG_TARGET:+-target "${ZIG_TARGET}"} "$@"
else
    exec python3 -m ziglang cc ${ZIG_TARGET:+-target "${ZIG_TARGET}"} "$@"
fi
